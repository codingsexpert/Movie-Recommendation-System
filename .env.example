# ============================================
# GraphRAG Environment Configuration
# ============================================

# Google Gemini API Key
# Get free: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# Neo4j Aura Free Database
# Get free: https://neo4j.com/cloud/aura-free/
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Pinecone Free Account
# Get free: https://app.pinecone.io
# Create index: name=movie-embeddings, dimensions=3072, metric=cosine
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=movie-embeddings
